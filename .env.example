# Copy to .env (and api/.env if you run the server from api/) and fill in real values.
# Never commit real secrets — .env files are git-ignored.

# ── Database (PostgreSQL) ─────────────────────────────────────
POSTGRES_URL=postgres://user:password@host:5432/database
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
DATABASE_URL=

# ── App ───────────────────────────────────────────────────────
# Leave unset (defaults to same-origin /api). Never set it to localhost on Vercel.
VITE_API_URL=
# Public site URL, used in password-reset emails. On Vercel: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=development

# ── Vercel Blob (cactus image storage) ────────────────────────
# Vercel dashboard → Storage → your Blob store → ".env.local" tab.
# Set automatically on Vercel when the Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="AstrophytumLab <your_email@gmail.com>"

# ── SMS (Twilio) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
